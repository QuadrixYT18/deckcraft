# DeckCraft live sessions: settings. Copy this file to deckcraft-server.env next to the start
# scripts and change what you need. Lines starting with # are ignored.
# Never commit deckcraft-server.env: it can hold your admin password.

# development (default): for a trusted local network. production: needs the two settings below.
#DECKCRAFT_MODE=development

# Where the server listens. Others on your network use this computer's address and this port.
#DECKCRAFT_BIND=0.0.0.0:8080

# Where sessions, presentations and backups are kept (default: the user's application data).
#DECKCRAFT_DATA=/path/to/folder

# The dashboard opens without a password on this computer (http://localhost:8080/host). To host
# from another computer, set a password of at least 12 characters.
#DECKCRAFT_ADMIN_PASSWORD=

# The address people use when the server is published behind HTTPS (required in production).
#DECKCRAFT_PUBLIC_URL=https://deck.example.com

# Other web pages allowed to call the API (comma separated origins). Usually empty.
#DECKCRAFT_ALLOWED_ORIGINS=
